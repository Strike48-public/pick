# StrikeHub (PLG) demo — Pick connector env (matrix#3519).
# Copy to .env.plg and customize, then `just plg-up`.
#
# The init-dev `plg:pick:up` / `plg:pick:attach` tasks generate this file
# automatically (prompting for / injecting the StrikeHub-minted OTT); this
# template is for running the compose unit standalone.
#
# HOW THIS DIFFERS FROM .env.dvwa.example:
#   PLG has no fixed tenant UUID — the personal tenant is minted at login. The
#   binding is the OTT (STRIKE48_TOKEN), which bakes the tenant_id into the
#   connector JWT via register-with-ott. So there is NO STRIKE48_TENANT here, and
#   STRIKE48_TOKEN is REQUIRED (the opposite of the dvwa demo, where the token is
#   omitted and the tenant UUID is required).

# ============ Strike48 backend (required) ============
#
# DNS NOTE (standalone runs): the pick container resolves via the Docker daemon's
# resolver and does NOT inherit host /etc/hosts, so a *.strike48.test mapping on
# your host won't reach it. docker-compose.plg.yml maps the backend hostnames to
# host-gateway via `extra_hosts:` for you; if your backend is reachable at a
# routable address instead, point STRIKE48_HOST / MATRIX_API_URL there.

# gRPC connector endpoint on the newdev backend. Use the http listener (:80,
# h2c) or the TLS listener (:443). This is the Gateway connectors-grpc-route.
STRIKE48_HOST=grpc://connectors-studio.strike48.test:80

# HTTP API base for OTT registration — the StrikeHub (PLG) host.
MATRIX_API_URL=https://plg.strike48.test

# ============ OTT — the PLG tenant binding (required) ============
#
# The One-Time Token minted in StrikeHub → Devices → install wizard. This IS the
# tenant binding: register-with-ott bakes its tenant_id into the connector JWT,
# so no STRIKE48_TENANT is needed. Mint it IMMEDIATELY before running the stack —
# it has a 15-minute TTL. Left as an obviously-invalid sentinel on purpose: a
# verbatim copy fails loudly instead of silently registering with a bogus token.
STRIKE48_TOKEN=REPLACE_ME_WITH_STRIKEHUB_OTT

# NOTE: NO STRIKE48_TENANT — intentionally absent. register-with-ott accepts no
# tenant_id param; the OTT carries the personal-tenant binding.

# ============ Connector identity (stable → approval sticks) ============

# A stable name + instance id. The OTT is pre-approval, so the connector comes
# online automatically; a stable identity keeps it consistent across restarts.
CONNECTOR_NAME=pick-plg
STRIKE48_INSTANCE_ID=pick-plg-01

# ============ newdev reachability (required on newdev) ============

# newdev's backend is a private IP / ClusterIP; the connector's SSRF guard
# blocks RFC-1918/loopback by default (169.254 cloud-metadata stays blocked).
# Without this, Pick silently refuses to connect to the backend host.
PENTEST_ALLOW_PRIVATE_IPS=true

# newdev serves self-signed *.strike48.test certs.
MATRIX_TLS_INSECURE=true
STRIKE48_ACCEPT_INVALID_CERTS=true

# ============ Logging ============
RUST_LOG=info,strike48_connector=info
