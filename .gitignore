# Rust
/target/
**/*.rs.bk
# Cargo.lock IS committed: this is an application workspace, so a committed
# lockfile gives reproducible CI/release builds and prevents surprise breakage
# from new upstream dependency releases. CI builds with --locked.

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
/dist/
*.wasm
*.js.map

# Logs
logs/
*.log

# Mobile
/apps/mobile/android/
/apps/mobile/ios/
/apps/mobile/.cargo/

# Trunk
/apps/web/dist/

# Environment
.env
.env.local
.env.*.local
# Backups/copies of .env - secret-bearing, never commit (e.g. .env.bak-238).
.env.bak
.env.bak-*
.env.*.bak
# StrikeKit demo env (docker-compose.dvwa.yml) - generated by the init-dev
# demo:pick tasks, carries the resolved tenant UUID + insecure-TLS flags.
.env.dvwa

# StrikeHub (PLG) env (docker-compose.plg.yml) - generated by the init-dev
# plg:pick tasks, carries the StrikeHub-minted OTT (a live token) + insecure-TLS
# flags. Never commit — gitleaks scans full history (see CLAUDE.md).
.env.plg

# AI tooling local overlays — private, operator-specific, never committed.
# See CLAUDE.md "Local Overrides" section.
CLAUDE.local.md
.claude/settings.local.json

# Temporary
/tmp/
*.tmp

**/build/

android-jniLibs

.strike48

# Mise
.mise.local.toml
.direnv/
__pycache__/
