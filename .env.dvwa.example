# StrikeKit DVWA demo — Pick connector env (matrix#3207).
# Copy to .env.dvwa and customize, then `just dvwa-up`.
#
# The init-dev `demo:pick:up` / `demo:pick:attach` tasks generate this file
# automatically (resolving the demo realm's tenant UUID); this template is for
# running the compose unit standalone.

# ============ Strike48 backend (required) ============
#
# DNS NOTE (standalone runs): the pick container resolves via the Docker daemon's
# resolver and does NOT inherit host /etc/hosts, so a *.strike48.test mapping on
# your host won't reach it. For a standalone `just dvwa-up` against newdev, add an
# `extra_hosts:` entry (host-gateway) for these names, or point STRIKE48_HOST /
# MATRIX_API_URL at a container-resolvable address. The init-dev demo:pick tasks
# wire this up for you.

# gRPC connector endpoint on the newdev backend. Use the http listener (:80,
# h2c) or the TLS listener (:443). This is the Gateway connectors-grpc-route.
STRIKE48_HOST=grpc://connectors-studio.strike48.test:80

# HTTP API base for OTT registration.
MATRIX_API_URL=https://studio.strike48.test

# The DEMO REALM's tenant UUID — NOT the realm name. Resolve it from Keycloak /
# the backend before bringing the stack up (the init-dev tasks do this for you).
# Left as an obviously-invalid sentinel on purpose: a verbatim copy fails loudly
# instead of silently registering under a bogus (e.g. all-zeros) tenant.
STRIKE48_TENANT=REPLACE_ME_WITH_DEMO_TENANT_UUID

# ============ Connector identity (stable → approval sticks) ============

# A stable name + instance id so the operator's Approve persists across restarts
# (the minted JWT is keyed to connector_name + instance_id).
CONNECTOR_NAME=pick-demo
STRIKE48_INSTANCE_ID=pick-demo-01

# STRIKE48_TOKEN intentionally omitted — Pick registers PENDING and the operator
# approves it in Studio → Gateways (the OTT flow; JWTs are short-lived, so we do
# NOT pre-mint one). Uncomment only to inject a pre-obtained JWT.
# STRIKE48_TOKEN=

# ============ newdev reachability (required on newdev) ============

# newdev's backend is a private IP / ClusterIP; the connector's SSRF guard
# blocks RFC-1918/loopback by default (169.254 cloud-metadata stays blocked).
# Without this, Pick silently refuses to connect to the backend host.
PENTEST_ALLOW_PRIVATE_IPS=true

# newdev serves self-signed *.strike48.test certs.
MATRIX_TLS_INSECURE=true
STRIKE48_ACCEPT_INVALID_CERTS=true

# ============ Logging ============
RUST_LOG=info,strike48_connector=info
