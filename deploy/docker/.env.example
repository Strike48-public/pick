# Pick connector configuration.
#
# Copy this file to .env (same directory as docker-compose.yml) and fill in the
# four REQUIRED values. Lines starting with # are comments. A key that stays
# commented out is NOT passed to the container. Keep it that way for anything
# in the optional section you do not use: the connector treats an empty value
# as set, not absent.

# ============ Required: your Strike48 Studio ============

# WebSocket endpoint of your Studio on port 443. Same hostname you open in the
# browser, with wss:// in place of https://. No port, no path.
STRIKE48_HOST=wss://studio.example.com

# HTTPS origin of the same Studio, with a trailing slash. The connector posts
# its registration here, overriding any callback address the Studio advertises.
STRIKE48_API_URL=https://studio.example.com/

# Your tenant UUID (8-4-4-4-12 hex), supplied by Strike48. A slug is accepted,
# but Studio routes by UUID, so use the UUID.
STRIKE48_TENANT=00000000-0000-0000-0000-000000000000

# A stable identifier for THIS install, for example the host name. The approval
# is keyed to it: change it and the connector registers as a new, unapproved
# gateway.
STRIKE48_INSTANCE_ID=pick-dc1-01

# ============ Optional ============

# Image tag. 0.1.10 is the release approved for customer use.
# PICK_IMAGE_TAG=0.1.10

# Gateway name shown in Studio. Instances that share a name are load-balanced
# as one gateway; give each host its own name to address them individually.
# CONNECTOR_NAME=pentest-connector

# Pre-approval. Paste a registration token (ott_...) issued by your Studio to
# skip the manual approve step. Tokens are single-use and expire in 15 minutes:
# uncomment and fill this immediately before `docker compose up`, and comment
# it out again afterwards. Never leave it blank: an empty value breaks
# registration.
# STRIKE48_REGISTRATION_TOKEN=

# Egress proxy (HTTP CONNECT). The standard variables; lowercase spellings are
# honoured too.
# HTTPS_PROXY=http://proxy.corp.example.com:3128
# NO_PROXY=

# Private or TLS-inspection CA. This is the path INSIDE the container; mount the
# PEM file with a docker-compose.override.yml as shown in the install guide.
# The CA is added to the system roots, not substituted for them.
# MATRIX_TLS_CA_CERT=/etc/pick/corp-ca.pem

# Allow tools to target RFC 1918 and loopback addresses. Off by default. Turn
# on only when your rules of engagement include private ranges.
# PENTEST_ALLOW_PRIVATE_IPS=true

# Log verbosity. Raise to debug only when support asks for it.
# RUST_LOG=info,strike48_connector=info
