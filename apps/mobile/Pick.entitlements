<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Entitlements re-signed onto the ad-hoc Simulator build (see build-ios's
      _sign-ios-entitlements) so the Matrix chat token persists in the Keychain
      (crates/platform/src/ios/keychain.rs). Without these, SecItemAdd fails
      with errSecMissingEntitlement (-34018) and the app re-prompts sign-in
      every launch.

      The crux is `application-identifier`: ad-hoc signing omits it, and the
      Keychain subsystem needs it to attribute a default access group to the
      process. `keychain-access-groups` must share its prefix (Apple TN2415:
      "all prefixes must match"). On the Simulator there is no provisioning
      profile to validate the prefix, so a hardcoded placeholder team id works;
      it just must stay STABLE across builds or previously-stored items orphan.
      (A real device/App Store build needs a genuine team id from its profile.)
    -->
    <key>application-identifier</key>
    <string>S7R1K3P1CK.com.strike48.pick</string>
    <key>keychain-access-groups</key>
    <array>
        <string>S7R1K3P1CK.com.strike48.pick</string>
    </array>
    <!-- Debug-attach + matches Xcode's simulator debug entitlements. Must be the
         `com.apple.security.`-prefixed key; bare `get-task-allow` crashes launch. -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
