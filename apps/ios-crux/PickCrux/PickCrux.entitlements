<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Grants the app a keychain access group so SecItem add/copy/delete succeed.
	  Without this, keychain calls fail with errSecMissingEntitlement (-34018)
	  and the persisted auth token never survives a relaunch. Ad-hoc signing
	  (CODE_SIGN_IDENTITY = "-") applies these entitlements on the simulator
	  without a paid team / provisioning profile.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>com.strike48.pickcrux</string>
	</array>
</dict>
</plist>
